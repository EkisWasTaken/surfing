{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Surf Sandbox",
  "version": "0.1.0",
  "identifier": "io.github.ekiswastaken.surfsandbox",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Surf Sandbox",
        "width": 1280,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU2MkIwOTc1NzBERDM3RUEKUldUcU45MXdkUWtyVmpWdlpFcGMyYUc1dW85Z21vait3YndYaWdWanIxMTNvRFZpVWlpY2RFcDQK",
      "endpoints": [
        "https://github.com/EkisWasTaken/surfing/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
