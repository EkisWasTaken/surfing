{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Surf Sandbox",
  "version": "0.1.0",
  "identifier": "io.github.ekiswastaken.surfsandbox",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      { "title": "Surf Sandbox", "width": 1280, "height": 720, "minWidth": 800, "minHeight": 600, "center": true }
    ],
    "security": { "csp": null }
